{
  "name": "orca-lab-site",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build",
    "preview": "astro preview",
    "test": "pnpm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/*.test.mjs\"",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/*.test.mjs\"",
    "shots": "node scripts/shots.mjs",
    "translations": "node scripts/translations.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.4",
    "github-slugger": "2.0.0",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.24.0"
}
