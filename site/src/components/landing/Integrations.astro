---
import { docsHref, type Lang, reviewProviders, taskProviders } from '../../data/product'
import Recording from './Recording.astro'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    eyebrow: 'Integrations',
    title: 'Your tracker holds the work. Your forge holds the code.',
    lede: 'Start a worktree from a ticket, with its context, and follow its PR, checks and review without leaving Orca Lab.',
    tasks: 'Task providers',
    tasksNote: 'Browse tickets, start workspaces and feed the lead’s To Do.',
    review: 'Review providers',
    reviewNote: 'Pull and merge requests, checks, review status.',
    cli: 'Agents read and move the same tickets with `orca plane` and `orca linear`.',
    more: 'Plane and Linear tasks'
  },
  es: {
    eyebrow: 'Integraciones',
    title: 'Tu tracker guarda el trabajo. Tu forja guarda el código.',
    lede: 'Abre un worktree desde un ticket, con su contexto, y sigue su PR, checks y revisión sin salir de Orca Lab.',
    tasks: 'Proveedores de tareas',
    tasksNote: 'Explora tickets, abre espacios de trabajo y alimenta el To Do del líder.',
    review: 'Proveedores de revisión',
    reviewNote: 'Pull y merge requests, checks, estado de revisión.',
    cli: 'Los agentes leen y mueven los mismos tickets con `orca plane` y `orca linear`.',
    more: 'Tareas de Plane y Linear'
  }
}[lang]

const code = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>')
const groups = [
  { title: copy.tasks, note: copy.tasksNote, items: taskProviders.map((p) => p.label) },
  { title: copy.review, note: copy.reviewNote, items: reviewProviders }
]
---

<section class="section" id="integrations" aria-labelledby="integrations-title">
  <div class="wrap">
    <p class="heading">▾ {copy.eyebrow}</p>
    <h2 class="h2" id="integrations-title">{copy.title}</h2>
    <p class="lede">{copy.lede}</p>
    <div class="stage">
      <Recording lang={lang} file="plane-board.gif" />
    </div>
    <div class="groups">
      {
        groups.map((group) => (
          <div class="group">
            <h3>{group.title}</h3>
            <p class="muted">{group.note}</p>
            <p class="names">{group.items.join(' · ')}</p>
          </div>
        ))
      }
      <div class="group">
        <p class="muted" set:html={code(copy.cli)} />
        <ul class="links">
          <li><a href={docsHref(lang, 'review/linear')}>{copy.more}</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    margin-top: var(--space-xl);
  }
  .groups {
    display: grid;
    gap: var(--space-lg) var(--space-xl);
    margin-top: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  h3 {
    margin: 0;
    font-size: 16px;
  }
  .group p {
    margin: 4px 0 0;
  }
  .names {
    font-weight: 700;
    color: var(--gold);
  }
</style>
