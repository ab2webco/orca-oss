---
import { docsHref, type Lang, reviewProviders, taskProviders } from '../../data/product'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    eyebrow: 'Integrations',
    title: 'Your tracker holds the work. Your forge holds the code.',
    lede: 'The lead turns one into the other. Browse tickets, start a worktree with the ticket’s context, and follow its PR, checks and review status without leaving Orca Lab.',
    tasks: 'Task providers',
    tasksNote: 'Browse and start workspaces from tickets. Any of them can feed the lead’s To Do.',
    review: 'Review providers',
    reviewNote: 'Pull and merge requests, checks and review status.',
    cli: 'Agents read and move the same tickets with `orca plane` and `orca linear`.',
    more: 'Plane and Linear tasks'
  },
  es: {
    eyebrow: 'Integraciones',
    title: 'Tu tracker guarda el trabajo. Tu forja guarda el código.',
    lede: 'El líder convierte uno en el otro. Explora tickets, abre un worktree con el contexto del ticket y sigue su PR, sus checks y su revisión sin salir de Orca Lab.',
    tasks: 'Proveedores de tareas',
    tasksNote: 'Explora tickets y abre espacios de trabajo desde ellos. Cualquiera puede alimentar el To Do del líder.',
    review: 'Proveedores de revisión',
    reviewNote: 'Pull requests y merge requests, checks y estado de revisión.',
    cli: 'Los agentes leen y mueven los mismos tickets con `orca plane` y `orca linear`.',
    more: 'Tareas de Plane y Linear'
  }
}[lang]

const code = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>')
const groups = [
  { title: copy.tasks, note: copy.tasksNote, items: taskProviders.map((p) => p.label), tone: 'brand' },
  { title: copy.review, note: copy.reviewNote, items: reviewProviders, tone: 'ai' }
]
---

<section class="section integrations" id="integrations">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2 class="h2">{copy.title}</h2>
      <p class="lede">{copy.lede}</p>
    </div>
    <div class="groups">
      {
        groups.map((group) => (
          <div class={`card group tone-${group.tone} reveal`}>
            <h3>{group.title}</h3>
            <p class="note">{group.note}</p>
            <ul>
              {group.items.map((name) => (
                <li>
                  <span class="mark mono" aria-hidden="true">
                    {name
                      .split(' ')
                      .map((w) => w.charAt(0))
                      .join('')}
                  </span>
                  {name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="cli reveal" set:html={code(copy.cli)} />
    <a class="more" href={docsHref(lang, 'review/linear')}>{copy.more} →</a>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 48px;
  }
  .group {
    padding: 26px;
  }
  .group h3 {
    margin: 0;
    font-size: 18px;
  }
  .note {
    margin: 6px 0 20px;
    color: var(--fg-muted);
    font-size: 14.5px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    font-weight: 560;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    flex: none;
  }
  .tone-brand .mark {
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 14%, transparent);
  }
  .tone-ai .mark {
    color: var(--ai);
    background: color-mix(in srgb, var(--ai) 14%, transparent);
  }
  .cli {
    margin: 24px 0 0;
    color: var(--fg-muted);
  }
  :global(.integrations .cli code) {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--muted);
    color: var(--fg-soft);
    font-size: 0.9em;
  }
  .more {
    display: inline-block;
    margin-top: 12px;
    color: var(--brand);
    text-decoration: none;
    font-weight: 560;
  }
  @media (max-width: 899px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
</style>
