---
import { docsHref, type Lang } from '../../data/product'
import Recording from './Recording.astro'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    eyebrow: 'The desktop',
    title: 'Everything an agent needs, nothing that slows you down.',
    features: [
      ['agent-grid.gif', 'Every agent, one screen', 'Every live agent of every project, grouped by what it needs from you. Each cell is its own terminal.'],
      ['diff-note.gif', 'Notes on the diff, straight to the agent', 'A note in the gutter of an AI diff goes to the agent’s terminal.'],
      ['design-mode.gif', 'Design mode in the built-in browser', 'Pick an element an agent changed and send its selector, styles and HTML.'],
      ['worklog-plugin.gif', 'Plugins you review first', 'A sandboxed panel and a worker under Node’s permission model. Nothing runs until you consent.']
    ],
    basics: [
      ['One worktree per agent', 'No shared checkouts. Folders and SSH worktrees on remote machines work too.'],
      ['Jump anywhere', 'Chats, terminals, worktrees, settings and actions in one list.'],
      ['Terminals that outlive the window', 'A background daemon keeps them; a restart brings back their output.']
    ],
    moreTitle: 'And the rest of the toolbox',
    toolsLabel: 'Toolbox',
    docs: 'Browse the docs'
  },
  es: {
    eyebrow: 'El escritorio',
    title: 'Todo lo que un agente necesita, nada que te frene.',
    features: [
      ['agent-grid.gif', 'Todos los agentes, una pantalla', 'Cada agente vivo de cada proyecto, agrupado según lo que necesita de ti. Cada celda es su propia terminal.'],
      ['diff-note.gif', 'Notas en el diff, directo al agente', 'Una nota en el margen de un diff hecho por IA llega a la terminal del agente.'],
      ['design-mode.gif', 'Design mode en el navegador integrado', 'Elige un elemento que cambió un agente y envía su selector, estilos y HTML.'],
      ['worklog-plugin.gif', 'Plugins que revisas antes', 'Un panel aislado y un worker bajo el modelo de permisos de Node. Nada corre sin tu consentimiento.']
    ],
    basics: [
      ['Un worktree por agente', 'Sin checkouts compartidos. También sirven carpetas y worktrees por SSH en máquinas remotas.'],
      ['Salta a donde sea', 'Chats, terminales, worktrees, ajustes y acciones en una sola lista.'],
      ['Terminales que sobreviven a la ventana', 'Un daemon en segundo plano las mantiene; al reiniciar vuelve su salida.']
    ],
    moreTitle: 'Y el resto de la caja de herramientas',
    toolsLabel: 'Caja de herramientas',
    docs: 'Ver la documentación'
  }
}[lang]

type Tool = [string, string]
const tools: Record<Lang, { id: string; name: string; items: Tool[] }[]> = {
  en: [
    {
      id: 'agents',
      name: 'Agents',
      items: [
        ['Voice dictation', 'Speech models that run on your machine.'],
        ['Session history', 'Resume past sessions, local or over SSH.'],
        ['Automations', 'Scheduled prompts or commands, on any account.'],
        ['Orca Sonar', 'A repo index for agents, not grep.'],
        ['Skills', 'Install, update and share agent skills.'],
        ['Browser automation', '`orca goto`, `snapshot`, `click` drive the browser.']
      ]
    },
    {
      id: 'workspaces',
      name: 'Terminals and workspaces',
      items: [
        ['iOS & Android emulators', 'A pane beside the code, driven from the CLI.'],
        ['Floating workspace', 'A terminal or workspace kept on top.'],
        ['Port scanner', 'What each workspace listens on.'],
        ['Workspace cleanup', 'Stale worktrees by size, age and unpushed work.'],
        ['Quick commands', 'Saved commands, one shortcut away.'],
        ['Ghostty & Warp themes', 'Import the terminal theme you use.']
      ]
    },
    {
      id: 'git',
      name: 'Git, sharing and upkeep',
      items: [
        ['Sparse checkout presets', 'Only the folders a task needs.'],
        ['AI commit messages', 'Written from the staged diff.'],
        ['Fork sync', 'Fast-forward from upstream, safely.'],
        ['Artifacts', 'HTML or Markdown as a link, from the CLI.'],
        ['Crash reports', 'What died, memory and GPU, reviewed before sending.'],
        ['Low-memory warning', 'Agent terminals first, and what opened it.']
      ]
    }
  ],
  es: [
    {
      id: 'agents',
      name: 'Agentes',
      items: [
        ['Dictado por voz', 'Modelos de voz que corren en tu máquina.'],
        ['Historial de sesiones', 'Retoma sesiones, locales o por SSH.'],
        ['Automatizaciones', 'Prompts o comandos programados, en cualquier cuenta.'],
        ['Orca Sonar', 'Un índice del repo para agentes, no grep.'],
        ['Skills', 'Instala, actualiza y comparte skills de agentes.'],
        ['Automatización del navegador', '`orca goto`, `snapshot`, `click` manejan el navegador.']
      ]
    },
    {
      id: 'workspaces',
      name: 'Terminales y espacios',
      items: [
        ['Emuladores iOS y Android', 'Un panel junto al código, desde la CLI.'],
        ['Espacio flotante', 'Una terminal o un espacio siempre encima.'],
        ['Escáner de puertos', 'En qué puertos escucha cada espacio.'],
        ['Limpieza de espacios', 'Worktrees viejos por tamaño, antigüedad y trabajo sin subir.'],
        ['Comandos rápidos', 'Comandos guardados, a un atajo.'],
        ['Temas de Ghostty y Warp', 'Importa el tema de terminal que usas.']
      ]
    },
    {
      id: 'git',
      name: 'Git, compartir y mantenimiento',
      items: [
        ['Presets de sparse checkout', 'Solo las carpetas que necesita una tarea.'],
        ['Mensajes de commit con IA', 'Escritos desde el diff preparado.'],
        ['Sincronizar forks', 'Avanza desde upstream, de forma segura.'],
        ['Artifacts', 'HTML o Markdown como enlace, desde la CLI.'],
        ['Reportes de fallos', 'Qué cayó, memoria y GPU, revisados antes de enviar.'],
        ['Aviso de poca memoria', 'Terminales de agentes primero, y qué lo abrió.']
      ]
    }
  ]
}

const code = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>')
---

<section class="section" id="desktop" aria-labelledby="desktop-title">
  <div class="wrap">
    <p class="heading">▾ {copy.eyebrow}</p>
    <h2 class="h2" id="desktop-title">{copy.title}</h2>
    <div class="features">
      {
        copy.features.slice(0, 1).map(([file, title, text]) => (
          <article class="split">
            <div>
              <h3>{title}</h3>
              <p class="muted">{text}</p>
            </div>
            <Recording lang={lang} file={file as 'agent-grid.gif'} />
          </article>
        ))
      }
    </div>
    <ul class="dash basics">
      {
        copy.basics.map(([title, text]) => (
          <li>
            <b>{title}.</b> <span>{text}</span>
          </li>
        ))
      }
    </ul>
    <div class="features">
      {
        copy.features.slice(1, 2).map(([file, title, text]) => (
          <article class="split">
            <div>
              <h3>{title}</h3>
              <p class="muted">{text}</p>
            </div>
            <Recording lang={lang} file={file as 'agent-grid.gif'} />
          </article>
        ))
      }
    </div>
    <h3 class="more-title" id="tools-title">{copy.moreTitle}</h3>
    <div class="tabs" role="tablist" aria-label={copy.toolsLabel} hidden data-tools>
      {
        tools[lang].map(({ id, name }, i) => (
          <button
            type="button"
            role="tab"
            id={`tools-tab-${id}`}
            aria-controls={`tools-panel-${id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {name}
          </button>
        ))
      }
    </div>
    {
      tools[lang].map(({ id, name, items }) => (
        <div class="group" id={`tools-panel-${id}`} role="tabpanel" aria-labelledby={`tools-tab-${id}`} data-tools-panel>
          <h4 class="group-title">{name}</h4>
          <dl class="tools">
            {items.map(([title, text]) => (
              <div>
                <dt>{title}</dt>
                <dd set:html={code(text)} />
              </div>
            ))}
          </dl>
        </div>
      ))
    }
    <div class="features">
      {
        copy.features.slice(2).map(([file, title, text]) => (
          <article class="split">
            <div>
              <h3>{title}</h3>
              <p class="muted">{text}</p>
            </div>
            <Recording lang={lang} file={file as 'agent-grid.gif'} />
          </article>
        ))
      }
    </div>
    <ul class="links">
      <li><a href={docsHref(lang, '')}>{copy.docs}</a></li>
    </ul>
  </div>
</section>

<script>
  import { wireTabList } from './tab-list'

  // Without script every group shows under its own title; with it, one group per tab.
  for (const list of document.querySelectorAll<HTMLElement>('[data-tools]')) {
    list.hidden = false
    for (const title of document.querySelectorAll<HTMLElement>('[data-tools-panel] .group-title')) {
      title.hidden = true
    }
    wireTabList([...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')])
  }
</script>

<style>
  .features {
    margin-top: var(--space-xl);
  }
  .features .split {
    margin-top: var(--space-2xl);
    align-items: center;
  }
  .features h3 {
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.2;
  }
  .features p {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-lead);
  }
  h3 {
    margin: 0;
    font-size: 16px;
  }
  .more-title {
    margin-top: var(--space-4xl);
  }
  .basics {
    margin-top: var(--space-3xl);
    font-size: var(--text-lead);
  }
  .group-title {
    margin: var(--space-lg) 0 0;
    font-size: var(--text-body);
    color: var(--muted);
  }
  .tools {
    display: grid;
    gap: 12px 32px;
    margin: 14px 0 0;
  }
  @media (min-width: 768px) {
    .tools {
      grid-template-columns: 1fr 1fr;
    }
  }
  .tools div {
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }
  dt {
    font-weight: 700;
  }
  dd {
    margin: 2px 0 0;
    color: var(--muted);
  }
</style>
