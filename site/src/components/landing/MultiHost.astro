---
import { docsHref, type Lang } from '../../data/product'
import Clip from './Clip.astro'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    eyebrow: 'Agentic, on every machine',
    title: 'The laptop you stopped using can run two members tonight.',
    lede: 'Pair any Orca as a host, and heavy tickets leave your main machine.',
    points: [
      ['Caps that add up', 'Memory and cores set each cap; a full host names another.'],
      ['Each host brings its accounts', 'Its Claude and Codex accounts: more quota, not just CPU.'],
      ['One fleet, both ways', 'Ticket, PR, CI, reports and terminal, like local ones.'],
      ['Private by default', 'Tailscale or LAN; `game resume-members` wakes them after a restart.']
    ],
    more: 'Headless Linux server guide'
  },
  es: {
    eyebrow: 'Agéntico, en cada máquina',
    title: 'La laptop que dejaste de usar puede correr dos miembros esta noche.',
    lede: 'Empareja cualquier Orca como host, y los tickets pesados dejan tu máquina principal.',
    points: [
      ['Topes que se suman', 'Memoria y núcleos fijan cada tope; un host lleno sugiere otro.'],
      ['Cada host trae sus cuentas', 'Sus cuentas de Claude y Codex: más cuota, no solo CPU.'],
      ['Una sola flota', 'Ticket, PR, CI, reportes y terminal, como los locales.'],
      ['Privado por defecto', 'Tailscale o red local; `game resume-members` los despierta tras reiniciar.']
    ],
    more: 'Guía de servidor Linux sin pantalla'
  }
}[lang]

const code = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>')
---

<section class="section" id="multi-host" aria-labelledby="multi-host-title">
  <div class="wrap">
    <p class="heading">▾ {copy.eyebrow}</p>
    <h2 class="h2" id="multi-host-title">{copy.title}</h2>
    <p class="lede">{copy.lede}</p>
    <div class="split flip">
      <ul class="dash">
        {
          copy.points.map(([title, text]) => (
            <li>
              <b>{title}.</b> <span set:html={code(text)} />
            </li>
          ))
        }
      </ul>
      <Clip lang={lang} name="team-machines" />
    </div>
    <ul class="links">
      <li><a href={docsHref(lang, 'remote/headless-linux-server')}>{copy.more}</a></li>
    </ul>
  </div>
</section>

