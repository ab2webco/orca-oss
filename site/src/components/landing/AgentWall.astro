---
import { agents, docsHref, type Lang } from '../../data/product'
import Recording from './Recording.astro'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    eyebrow: 'Bring your own agent',
    title: `${agents.length} coding agents. Your subscriptions. One screen.`,
    lede: 'The CLIs you already pay for, each in its own worktree. See which one needs you.',
    points: [
      ['Switch accounts mid-session', 'Several Claude and Codex accounts; the conversation resumes.'],
      ['Usage next to every agent', 'Rate limits and quota resets per account, before the wall.'],
      ['Resume any past session', 'Local or over SSH.']
    ],
    more: 'Supported agents'
  },
  es: {
    eyebrow: 'Trae tu propio agente',
    title: `${agents.length} agentes de código. Tus suscripciones. Una pantalla.`,
    lede: 'Las CLIs que ya pagas, cada una en su worktree. Ve cuál te necesita.',
    points: [
      ['Cambia de cuenta sin cortar la sesión', 'Varias cuentas de Claude y Codex; la conversación sigue.'],
      ['Uso junto a cada agente', 'Rate limit y reinicios de cuota por cuenta, antes del límite.'],
      ['Retoma cualquier sesión', 'Local o por SSH.']
    ],
    more: 'Agentes soportados'
  }
}[lang]
---

<section class="section" id="agents" aria-labelledby="agents-title">
  <div class="wrap">
    <p class="heading">▾ {copy.eyebrow}</p>
    <h2 class="h2" id="agents-title">{copy.title}</h2>
    <p class="lede">{copy.lede}</p>
    <div class="split">
      <div>
        <ul class="dash">
          {
            copy.points.map(([title, text]) => (
              <li>
                <b>{title}.</b> <span>{text}</span>
              </li>
            ))
          }
        </ul>
        <ul class="links">
          <li><a href={docsHref(lang, 'agents/supported')}>{copy.more}</a></li>
        </ul>
      </div>
      <Recording lang={lang} file="claude-accounts-switch.gif" />
    </div>
    <ul class="agents box" aria-label={copy.eyebrow}>
      {agents.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>

<style>
  .agents {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs) var(--space-lg);
    margin: var(--space-xl) 0 0;
    padding: var(--space-lg);
    list-style: none;
  }
  @media (min-width: 60rem) {
    .agents {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      font-size: var(--text-lead);
    }
  }
  .agents li::before {
    content: '● ';
    color: var(--muted);
  }
</style>
