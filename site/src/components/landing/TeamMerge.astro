---
import type { Lang } from '../../data/product'
import Clip from './Clip.astro'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    title: 'One ticket, one worktree, one agent',
    lede: 'The lead never writes code. It starts members, reads their reports and lands their PRs, and the team earns XP only from signals it can check.',
    steps: [
      ['Kai claims LUM-19', 'Its own worktree on feat/lum-19.'],
      ['PR #44, CI running', 'Checks come from GitHub, not from the agent.'],
      ['Green, in the merge queue', '#44 waits at the top of the PRs tab.'],
      ['Merged, and the team levels up', 'Every award counts: claim, green CI, review, Done and merge.']
    ]
  },
  es: {
    title: 'Un ticket, un worktree, un agente',
    lede: 'El líder nunca escribe código. Lanza miembros, lee sus reportes y mergea sus PR, y el equipo gana XP solo con señales que puede comprobar.',
    steps: [
      ['Kai toma LUM-19', 'Su propio worktree en feat/lum-19.'],
      ['PR #44, CI corriendo', 'Los checks vienen de GitHub, no del agente.'],
      ['En verde, en la merge queue', '#44 espera primero en la pestaña de PR.'],
      ['Mergeado, y el equipo sube de nivel', 'Cada premio cuenta: tomar el ticket, CI en verde, revisión, Done y merge.']
    ]
  }
}[lang]
---

<section class="section" id="orchestrator" aria-labelledby="team-title">
  <div class="wrap">
    <h2 class="h2" id="team-title">{copy.title}</h2>
    <p class="lede">{copy.lede}</p>
    <div class="chapter">
      <ol>
        {
          copy.steps.map(([title, body]) => (
            <li>
              <div>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <Clip lang={lang} name="team-merge" />
    </div>
  </div>
</section>

<style>
  .chapter {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
    align-items: center;
  }
  ol {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  li {
    display: grid;
    grid-template-columns: var(--space-xl) minmax(0, 1fr);
    counter-increment: step;
  }
  li::before {
    content: counter(step);
    color: var(--muted);
    font-size: var(--text-title);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  li p {
    margin: var(--space-2xs) 0 0;
    color: var(--fg-2);
  }
  @media (min-width: 60rem) {
    .chapter {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
</style>
