---
import { docsHref, homeHref, type Lang, REPO_URL, withBase } from '../../data/product'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    nav: [
      ['#orchestrator', 'Orchestrator'],
      ['#features', 'Features'],
      ['#integrations', 'Integrations'],
      ['#mobile', 'Mobile']
    ],
    docs: 'Docs',
    download: 'Download',
    otherLang: 'ES',
    otherLangLabel: 'Leer en español',
    theme: 'Toggle light and dark theme'
  },
  es: {
    nav: [
      ['#orchestrator', 'Orquestador'],
      ['#features', 'Funciones'],
      ['#integrations', 'Integraciones'],
      ['#mobile', 'Móvil']
    ],
    docs: 'Docs',
    download: 'Descargar',
    otherLang: 'EN',
    otherLangLabel: 'Read in English',
    theme: 'Cambiar entre tema claro y oscuro'
  }
}[lang]
const other: Lang = lang === 'es' ? 'en' : 'es'
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={homeHref(lang)}>
      <img src={withBase('icon.png')} alt="" width="28" height="28" />
      <span>Orca Lab</span>
    </a>
    <nav class="links" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
      {copy.nav.map(([href, label]) => <a href={href}>{label}</a>)}
      <a href={docsHref(lang, '')}>{copy.docs}</a>
    </nav>
    <div class="actions">
      <a class="icon-btn docs-mobile" href={docsHref(lang, '')}>{copy.docs}</a>
      <a class="icon-btn" href={homeHref(other)} hreflang={other} aria-label={copy.otherLangLabel}
        >{copy.otherLang}</a
      >
      <button class="icon-btn" type="button" data-theme-toggle aria-label={copy.theme}>
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
          ><circle cx="12" cy="12" r="4" fill="currentColor"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path></svg
        >
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
          ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"
          ></path></svg
        >
      </button>
      <a class="icon-btn gh" href={REPO_URL} aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path></svg
        >
      </a>
      <a class="btn btn-primary cta" href="#get">{copy.download}</a>
    </div>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement
    const next = root.dataset.theme === 'light' ? 'dark' : 'light'
    root.dataset.theme = next
    try {
      localStorage.setItem('starlight-theme', next)
    } catch {
      // Private mode: the toggle still works for this page view.
    }
  })
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    flex: none;
  }
  .brand img {
    border-radius: 7px;
  }
  .links {
    display: flex;
    gap: 4px;
    margin-left: 12px;
  }
  .links a {
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 9px;
    border: 1px solid transparent;
    background: none;
    color: var(--fg-muted);
    font: 600 12px/1 var(--font-mono);
    text-decoration: none;
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--border);
  }
  :global([data-theme='dark']) .moon,
  :global([data-theme='light']) .sun {
    display: none;
  }
  .docs-mobile {
    display: none;
  }
  .cta {
    min-height: 36px;
    padding: 0 14px;
    font-size: 14px;
  }
  @media (max-width: 899px) {
    .links {
      display: none;
    }
    .docs-mobile {
      display: inline-flex;
    }
  }
  @media (max-width: 479px) {
    .gh,
    .cta {
      display: none;
    }
    .bar {
      gap: 8px;
    }
  }
</style>
