---
import { ANDROID_RELEASES_URL, docsHref, type Lang } from '../../data/product'
import Recording from './Recording.astro'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    eyebrow: 'Mobile · iOS and Android',
    title: 'Your agents, in your pocket.',
    lede: 'Pair once by QR code. Directly or through an end-to-end encrypted relay, a lead’s question finds you anywhere.',
    phones: [
      ['mobile-inbox-ios.gif', 'Owner-question Inbox', 'Answer the lead’s decision with one tap.'],
      ['mobile-team-android.gif', 'Team drawer', 'Open questions, each member’s ticket, state, PR and CI, merges per day, lead time.'],
      ['mobile-terminal-ios.gif', 'Live terminals', 'Watch any agent’s terminal stream and type into it.']
    ],
    ios: 'iOS via TestFlight',
    android: 'Android APK',
    more: 'Mobile guide'
  },
  es: {
    eyebrow: 'Móvil · iOS y Android',
    title: 'Tus agentes, en tu bolsillo.',
    lede: 'Empareja una vez por QR. Directo o por un relay cifrado de extremo a extremo, la pregunta de un líder te encuentra donde estés.',
    phones: [
      ['mobile-inbox-ios.gif', 'Inbox de preguntas', 'Responde la decisión del líder con un toque.'],
      ['mobile-team-android.gif', 'Cajón del equipo', 'Preguntas abiertas, ticket, estado, PR y CI de cada miembro, merges por día, lead time.'],
      ['mobile-terminal-ios.gif', 'Terminales en vivo', 'Mira la terminal de cualquier agente en tiempo real y escribe en ella.']
    ],
    ios: 'iOS por TestFlight',
    android: 'APK de Android',
    more: 'Guía de la app móvil'
  }
}[lang]
---

<section class="section" id="mobile" aria-labelledby="mobile-title">
  <div class="wrap">
    <p class="heading">▾ {copy.eyebrow}</p>
    <h2 class="h2" id="mobile-title">{copy.title}</h2>
    <p class="lede">{copy.lede}</p>
    <ul class="phones">
      {
        copy.phones.map(([file, title, text]) => (
          <li>
            <Recording lang={lang} file={file as 'mobile-inbox-ios.gif'} isPhone />
            <h3>{title}</h3>
            <p class="muted">{text}</p>
          </li>
        ))
      }
    </ul>
    <ul class="links">
      <li><a href={ANDROID_RELEASES_URL}>{copy.android}</a></li>
      <li><a href={docsHref(lang, 'mobile')}>{copy.more}</a></li>
    </ul>
    <p class="muted">{copy.ios}</p>
  </div>
</section>

<style>
  .phones {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px 32px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .phones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Why subgrid: the Android recording is taller, and the titles still share one line. */
    .phones li {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }
  h3 {
    margin: var(--space-md) 0 0;
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.2;
  }
  .phones p {
    margin: 6px 0 14px;
  }
</style>
