---
import { docsHref, type Lang } from '../../data/product'
import Clip from './Clip.astro'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    title: 'The IDE for coding agent teams',
    lede: 'A lead agent hands each ticket to its own agent and worktree, on every machine you own, and asks you only what only you can decide.',
    download: 'Download',
    guide: 'Read the guide',
    fact: 'Free and MIT licensed, for macOS, Windows and Linux, with apps for iOS and Android.'
  },
  es: {
    title: 'El IDE para equipos de agentes de código',
    lede: 'Un agente líder da cada ticket a su propio agente y worktree, en cada máquina que tengas, y solo te pregunta lo que solo tú puedes decidir.',
    download: 'Descargar',
    guide: 'Leer la guía',
    fact: 'Libre y con licencia MIT, para macOS, Windows y Linux, con apps para iOS y Android.'
  }
}[lang]
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <h1 id="hero-title">{copy.title}</h1>
    <div class="copy">
      <p class="lede">{copy.lede}</p>
      <div class="actions">
        <a class="btn" href="#get">{copy.download}</a>
        <a class="btn quiet" href={docsHref(lang, 'get-started')}>{copy.guide}</a>
      </div>
      <p class="fact">{copy.fact}</p>
    </div>
    <Clip lang={lang} name="team-office-building" isEager />
  </div>
</section>

<style>
  .hero {
    padding: var(--space-xl) 0 var(--space-lg);
  }
  .grid {
    display: grid;
    gap: var(--space-lg) var(--space-xl);
    align-items: center;
  }
  /* Stacked, the clip stands --space-xl below the copy, as it did before the two columns. */
  .copy {
    padding-bottom: calc(var(--space-xl) - var(--space-lg));
  }
  h1 {
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }
  .lede {
    margin: 0;
    max-width: 34ch;
    color: var(--fg-2);
    font-size: var(--text-lead);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-lg);
    border: 1px solid var(--fg);
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }
  .btn.quiet {
    border-color: var(--line);
    background: transparent;
    color: var(--fg);
    font-weight: 400;
  }
  .btn.quiet:hover {
    background: var(--surface);
  }
  .fact {
    margin: var(--space-md) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  /* Why the title spans both columns: beside the clip it broke into four lines. Why the clip sits
     beside the copy: stacked under it, it ran past the 1440x900 and 1920x1080 first screens. */
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
    }
    .copy {
      padding-bottom: 0;
    }
    h1 {
      grid-column: 1 / -1;
      max-width: none;
    }
  }
</style>
