---
import '../../styles/feature-bento.css'
import { docsHref, type Lang } from '../../data/product'

type Props = {
  lang: Lang
}

const { lang } = Astro.props
const copy = {
  en: {
    eyebrow: 'The desktop',
    title: 'Everything an agent needs, nothing that slows you down.',
    gridTitle: 'Every agent, one screen',
    gridBody: 'The agent grid groups every live agent of every project by what it needs from you. Each cell is the agent’s own terminal.',
    buckets: ['Needs You', 'Working', 'Done', 'Idle'],
    treeTitle: 'One worktree per agent',
    treeBody: 'Agents never share a checkout. Folders work as workspaces too, and SSH worktrees run on remote machines.',
    diffTitle: 'Notes on the diff, straight to the agent',
    diffBody: 'Leave a note in the gutter of an AI diff and send it to the agent’s terminal.',
    diffNote: 'Add note for the AI',
    designTitle: 'Design mode in the built-in browser',
    designBody: 'Pick an element on the page an agent changed and send a change request with its selector, styles and HTML.',
    paletteTitle: 'Jump anywhere',
    paletteBody: 'Chats, terminals, worktrees, settings and actions in one list.',
    daemonTitle: 'Terminals that outlive the window',
    daemonBody: 'Tabs and splits run in a background daemon; a restart reconnects them with their recent output.',
    moreTitle: 'And the rest of the toolbox',
    docs: 'Browse the docs'
  },
  es: {
    eyebrow: 'El escritorio',
    title: 'Todo lo que un agente necesita, nada que te frene.',
    gridTitle: 'Todos los agentes, una pantalla',
    gridBody: 'La grilla de agentes agrupa cada agente vivo de cada proyecto según lo que necesita de ti. Cada celda es la terminal del propio agente.',
    buckets: ['Needs You', 'Working', 'Done', 'Idle'],
    treeTitle: 'Un worktree por agente',
    treeBody: 'Los agentes nunca comparten un checkout. Las carpetas también sirven como espacio de trabajo, y los worktrees por SSH corren en máquinas remotas.',
    diffTitle: 'Notas en el diff, directo al agente',
    diffBody: 'Deja una nota en el margen de un diff hecho por IA y envíala a la terminal del agente.',
    diffNote: 'Nota para la IA',
    designTitle: 'Design mode en el navegador integrado',
    designBody: 'Elige un elemento de la página que cambió un agente y envía un pedido de cambio con su selector, estilos y HTML.',
    paletteTitle: 'Salta a donde sea',
    paletteBody: 'Chats, terminales, worktrees, ajustes y acciones en una sola lista.',
    daemonTitle: 'Terminales que sobreviven a la ventana',
    daemonBody: 'Pestañas y divisiones corren en un daemon en segundo plano; al reiniciar se reconectan con su salida reciente.',
    moreTitle: 'Y el resto de la caja de herramientas',
    docs: 'Ver la documentación'
  }
}[lang]

const tools: Record<Lang, [string, string][]> = {
  en: [
    ['Voice dictation', 'Talk to an agent with speech models that run on your machine.'],
    ['Session history', 'Find and resume past agent sessions, local or over SSH.'],
    ['iOS & Android emulators', 'An emulator pane next to the code, drivable from the CLI.'],
    ['Floating workspace', 'Pop a terminal or workspace out and keep it on top.'],
    ['Port scanner', 'See what each workspace is listening on.'],
    ['Workspace cleanup', 'Find stale worktrees by size, age and unpushed work.'],
    ['Sparse checkout presets', 'Check out only the folders a task needs.'],
    ['Quick commands', 'Saved commands one shortcut away in any terminal.'],
    ['Ghostty & Warp themes', 'Import the terminal theme you already use.'],
    ['AI commit messages', 'Generate a commit message from the staged diff.'],
    ['Fork sync', 'Fast-forward your fork from upstream, safely.'],
    ['Automations', 'Scheduled prompts or commands on the account you choose.'],
    ['Plugins', 'Sandboxed panels and workers; nothing runs until you review it.'],
    ['Orca Sonar', 'An index of the repo for agents instead of grep.'],
    ['Skills', 'Install, update and share agent skills.'],
    ['Artifacts', 'Share HTML or Markdown as a link from the CLI.'],
    ['Browser automation', '`orca goto`, `orca snapshot`, `orca click` drive the built-in browser.'],
    ['Crash reports', 'The process that died, memory and GPU state, reviewed before sending.'],
    ['Low-memory warning', 'Lists agent terminals first and says what opened it.']
  ],
  es: [
    ['Dictado por voz', 'Háblale a un agente con modelos de voz que corren en tu máquina.'],
    ['Historial de sesiones', 'Encuentra y retoma sesiones de agentes, locales o por SSH.'],
    ['Emuladores iOS y Android', 'Un panel de emulador junto al código, controlable desde la CLI.'],
    ['Espacio flotante', 'Saca una terminal o un espacio de trabajo y déjalo encima.'],
    ['Escáner de puertos', 'Ve en qué puertos escucha cada espacio de trabajo.'],
    ['Limpieza de espacios', 'Encuentra worktrees viejos por tamaño, antigüedad y trabajo sin subir.'],
    ['Presets de sparse checkout', 'Baja solo las carpetas que necesita una tarea.'],
    ['Comandos rápidos', 'Comandos guardados a un atajo en cualquier terminal.'],
    ['Temas de Ghostty y Warp', 'Importa el tema de terminal que ya usas.'],
    ['Mensajes de commit con IA', 'Genera el mensaje de commit desde el diff preparado.'],
    ['Sincronizar forks', 'Avanza tu fork desde upstream, de forma segura.'],
    ['Automatizaciones', 'Prompts o comandos programados en la cuenta que elijas.'],
    ['Plugins', 'Paneles y workers aislados; nada corre hasta que lo revisas.'],
    ['Orca Sonar', 'Un índice del repo para los agentes en lugar de grep.'],
    ['Skills', 'Instala, actualiza y comparte skills de agentes.'],
    ['Artifacts', 'Comparte HTML o Markdown como enlace desde la CLI.'],
    ['Automatización del navegador', '`orca goto`, `orca snapshot`, `orca click` manejan el navegador integrado.'],
    ['Reportes de fallos', 'El proceso que cayó, memoria y estado de GPU, revisados antes de enviar.'],
    ['Aviso de poca memoria', 'Lista primero las terminales de agentes y dice qué lo abrió.']
  ]
}

const code = (text: string) => text.replace(/`([^`]+)`/g, '<code>$1</code>')
const agentsInGrid = [
  ['question', 'review-agent', 0],
  ['working', 'build-agent', 1],
  ['working', 'test-agent', 1],
  ['done', 'ship-agent', 2]
] as const
---

<section class="section bento-section" id="features">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2 class="h2">{copy.title}</h2>
    </div>

    <div class="bento">
      <article class="card tile t-grid reveal">
        <h3>{copy.gridTitle}</h3>
        <p>{copy.gridBody}</p>
        <div class="mini-grid" aria-hidden="true">
          {
            copy.buckets.map((bucket, i) => (
              <div class="bucket">
                <span class="bname">
                  <span class="dot" data-state={['question', 'working', 'done', 'idle'][i]} />
                  {bucket}
                </span>
                {agentsInGrid
                  .filter(([, , b]) => b === i)
                  .map(([state, name]) => (
                    <span class="cell">
                      <span class="dot" data-state={state} />
                      <span class="mono">{name}</span>
                    </span>
                  ))}
              </div>
            ))
          }
        </div>
      </article>

      <article class="card tile t-tree reveal">
        <h3>{copy.treeTitle}</h3>
        <p>{copy.treeBody}</p>
        <pre class="mini-tree mono" aria-hidden="true">main
├─ acme-204-card-retry   <b>claude</b>
├─ acme-206-search-limits <b>codex</b>
└─ gh-482-safari-login   <b>gemini</b></pre>
      </article>

      <article class="card tile t-diff reveal">
        <h3>{copy.diffTitle}</h3>
        <p>{copy.diffBody}</p>
        <div class="mini-diff mono" aria-hidden="true">
          <span class="del">- retries: 0</span>
          <span class="add">+ retries: 3</span>
          <span class="add">+ backoff: 'exponential'</span>
          <span class="note">＋ {copy.diffNote}</span>
        </div>
      </article>

      <article class="card tile t-design reveal">
        <h3>{copy.designTitle}</h3>
        <p>{copy.designBody}</p>
        <div class="mini-browser" aria-hidden="true">
          <span class="url mono">app.example.com/pricing</span>
          <span class="pick">Start free trial<span class="sel mono">button.cta-primary</span></span>
        </div>
      </article>

      <article class="card tile t-palette reveal">
        <h3>{copy.paletteTitle}</h3>
        <p>{copy.paletteBody}</p>
        <p class="keys" aria-label="Cmd+J, Ctrl+Shift+J">
          <kbd>⌘</kbd><kbd>J</kbd><span>·</span><kbd>Ctrl</kbd><kbd>Shift</kbd><kbd>J</kbd>
        </p>
      </article>

      <article class="card tile t-daemon reveal">
        <h3>{copy.daemonTitle}</h3>
        <p>{copy.daemonBody}</p>
      </article>
    </div>

    <h3 class="tools-title reveal">{copy.moreTitle}</h3>
    <ul class="tools reveal">
      {
        tools[lang].map(([title, body]) => (
          <li>
            <h4>{title}</h4>
            <p set:html={code(body)} />
          </li>
        ))
      }
    </ul>
    <a class="more" href={docsHref(lang, '')}>{copy.docs} →</a>
  </div>
</section>
