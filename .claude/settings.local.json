{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-release-upstream-check.sh",
            "if": "Bash(gh workflow run*)",
            "timeout": 30,
            "statusMessage": "Checking upstream (stablyai/orca) before release..."
          }
        ]
      }
    ]
  }
}
