{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    // Mobile stays on TypeScript 6 so Expo/Metro can still use the JS
    // compiler API (require('typescript').sys) during release bundling.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "tweetnacl": ["./node_modules/tweetnacl"],
      "ws": ["./node_modules/@types/ws"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Why the scene engine apart: it runs the desktop's painters in a WebView, typechecked with the
  // desktop's compiler by tsconfig.scene-engine.json.
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/team-drawer/team-scene-engine.ts",
    "src/team-drawer/team-scene-webview-shims.ts"
  ]
}
